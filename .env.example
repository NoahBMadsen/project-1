NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres.your-project-ref:[password]@aws-1-us-west-1.pooler.supabase.com:5432/postgres
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# From my.plantnet.org → API Keys
PLANTNET_API_KEY=your-plantnet-api-key
# Madsen Senior Project Linear workspace only (for Cursor linear-bramble MCP)
LINEAR_BRAMBLE_API_KEY=lin_api_your_madsen_workspace_key
